{
  "name": "@portaless/templates",
  "version": "0.1.0",
  "description": "Fictional demo site profile, showcase templates, and original local SVG assets for Portaless (D11).",
  "license": "CC0-1.0",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/geroiloyola/portaless-templates.git"
  },
  "homepage": "https://github.com/geroiloyola/portaless-templates#readme",
  "main": "./index.mjs",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./index.mjs"
    },
    "./demo/*": "./demo/*",
    "./package.json": "./package.json"
  },
  "files": [
    "index.mjs",
    "index.d.ts",
    "demo/",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "verify": "node scripts/verify-templates.mjs",
    "smoke:tarball": "node scripts/smoke-tarball.mjs",
    "test": "npm run verify && npm run smoke:tarball"
  }
}
